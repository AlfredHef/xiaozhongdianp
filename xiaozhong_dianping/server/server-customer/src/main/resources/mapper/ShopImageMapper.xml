<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fudan.xiaozhong_dianping.shop.mapper.ShopImageMapper">
    <resultMap id="ShopImageResultMap" type="com.fudan.xiaozhong_dianping.shop.entity.ShopImage">
        <id column="id" property="id" jdbcType="BIGINT" />
        <result column="shop_id" property="shopId" jdbcType="BIGINT" />
        <result column="image_url" property="imageUrl" jdbcType="VARCHAR" />
        <result column="description" property="description" jdbcType="VARCHAR" />
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP" />
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP" />
    </resultMap>
    <select id="findImagesByShopId" parameterType="java.lang.Long" resultType="com.fudan.xiaozhong_dianping.shop.entity.ShopImage">
        SELECT * FROM shop_image WHERE shop_id = #{shopId}
    </select>

</mapper>